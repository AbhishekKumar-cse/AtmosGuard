# Copy to backend/.env and fill in. backend/.env is gitignored - never commit it.

# IMD API key from https://api.imd.gov.in (bound to this server's static public IP).
IMD_API_KEY=

# How the key is sent. Leave empty, run `python -m app.ingest.imd_api --probe`,
# then set this to the scheme it reports, e.g. header-x-api-key or query-api_key.
IMD_API_AUTH=
